# Environment Variables Template
# Copy this file to .env and update the values with your configuration

# S3 Configuration
S3_BUCKET=your-s3-bucket-name

# AWS Configuration (optional - will use AWS credentials from other sources if not set)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1

# Neptune Configuration (for other scripts)
# NEPTUNE_ENDPOINT=your-neptune-endpoint
# NEPTUNE_PORT=8182

# SSH Tunnel Configuration (for other scripts)
# SSH_HOST=your-ssh-host
# SSH_USER=your-ssh-user
# SSH_KEY_PATH=/path/to/your/private/key
# LOCAL_PORT=8182
# REMOTE_PORT=8182

# Data Generation Configuration (for other scripts)
# PERSON_RECORDS=1000
# ADDRESS_RECORDS=500 