# Environment Variables Template
# Copy this file to .env and update the values with your configuration

# Required Environment Variables
S3_BUCKET=your-s3-bucket-name
NEPTUNE_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/NeptuneLoadFromS3

# Optional Environment Variables
NEPTUNE_ENDPOINT=https://localhost:8182
AWS_REGION=us-east-1
S3_PREFIX=
S3_EXCLUDE_PATTERNS=archive/,backup/,old/,temp/,tmp/

# Performance Configuration (optional)
# NEPTUNE_PERFORMANCE_MODE=true
# NEPTUNE_ULTRA_MODE=true
# NEPTUNE_CONCURRENT_LIMIT=4
# NEPTUNE_QUEUE_WAIT_TIME=5
# NEPTUNE_MAX_RETRY_ATTEMPTS=2
# NEPTUNE_BACKOFF_MULTIPLIER=1.5
# NEPTUNE_INITIAL_BACKOFF=15
# NEPTUNE_MAX_BACKOFF=120
# NEPTUNE_HEALTH_CHECK_INTERVAL=15

# Neptune Loader Settings (optional)
# NEPTUNE_PARALLELISM=OVERSUBSCRIBE
# NEPTUNE_FAIL_ON_ERROR=false
# NEPTUNE_QUEUE_REQUEST=false
# NEPTUNE_TIMEOUT=3600
# NEPTUNE_CONNECT_TIMEOUT=30
# NEPTUNE_DEBUG=false

# AWS Configuration (optional - will use AWS credentials from other sources if not set)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1

# SSH Tunnel Configuration (for other scripts)
# SSH_HOST=your-ssh-host
# SSH_USER=your-ssh-user
# SSH_KEY_PATH=/path/to/your/private/key
# LOCAL_PORT=8182
# REMOTE_PORT=8182

# Data Generation Configuration (for other scripts)
# PERSON_RECORDS=1000
# ADDRESS_RECORDS=500 